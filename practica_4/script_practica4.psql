-- LIMPIEZA PREVIA

DROP TRIGGER IF EXISTS trg_actualizar_coste_total ON contiene;
DROP FUNCTION IF EXISTS recalcular_coste_total_pedido();

DROP TABLE IF EXISTS asignado CASCADE;
DROP TABLE IF EXISTS contiene CASCADE;
DROP TABLE IF EXISTS almacena CASCADE;
DROP TABLE IF EXISTS pedido CASCADE;
DROP TABLE IF EXISTS bonificacion CASCADE;
DROP TABLE IF EXISTS cliente_tajinaste_plus CASCADE;
DROP TABLE IF EXISTS zona CASCADE;
DROP TABLE IF EXISTS empleado CASCADE;
DROP TABLE IF EXISTS cliente CASCADE;
DROP TABLE IF EXISTS puesto CASCADE;
DROP TABLE IF EXISTS producto CASCADE;
DROP TABLE IF EXISTS vivero CASCADE;

-- ENTIDADES FUERTES

-- VIVERO
CREATE TABLE vivero (
    id_vivero SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    latitud NUMERIC(8,6) NOT NULL CHECK (latitud BETWEEN -90 AND 90),
    longitud NUMERIC(9,6) NOT NULL CHECK (longitud BETWEEN -180 AND 180)
);

-- PRODUCTO
CREATE TABLE producto (
    id_producto SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    descripcion TEXT,
    precio_base NUMERIC(10,2) NOT NULL CHECK (precio_base >= 0)
);

-- PUESTO
CREATE TABLE puesto (
    id_puesto SERIAL PRIMARY KEY,
    nombre_puesto VARCHAR(100) NOT NULL UNIQUE,
    descripcion TEXT
);

-- CLIENTE (Supertipo)
CREATE TABLE cliente (
    id_cliente SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    telefono VARCHAR(20)
);

-- EMPLEADO
CREATE TABLE empleado (
    id_empleado SERIAL PRIMARY KEY,
    dni VARCHAR(12) NOT NULL UNIQUE,
    nombre VARCHAR(50) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    telefono VARCHAR(20)
);


-- ENTIDADES DEBILES

-- ZONA depende de vivero
CREATE TABLE zona (
    id_zona SERIAL PRIMARY KEY,
    id_vivero INT NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    latitud NUMERIC(8,6) NOT NULL CHECK (latitud BETWEEN -90 AND 90),
    longitud NUMERIC(9,6) NOT NULL CHECK (longitud BETWEEN -180 AND 180),

    CONSTRAINT fk_zona_vivero FOREIGN KEY (id_vivero) 
        REFERENCES vivero(id_vivero) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT uq_vivero_zona UNIQUE (id_vivero, nombre)
);

-- CLIENTE_TAJINASTE_PLUS depende de cliente
CREATE TABLE cliente_tajinaste_plus (
    id_cliente INT PRIMARY KEY,
    fecha_ingreso DATE NOT NULL DEFAULT CURRENT_DATE,

    CONSTRAINT fk_plus_cliente FOREIGN KEY (id_cliente) 
        REFERENCES cliente(id_cliente) ON DELETE CASCADE ON UPDATE CASCADE
);

-- PEDIDO depende de cliente y de empleado
CREATE TABLE pedido (
    id_pedido SERIAL PRIMARY KEY,
    fecha TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    coste_total NUMERIC(8,2) DEFAULT 0.00 CHECK (coste_total >= 0),
    id_cliente INT NOT NULL,
    id_empleado INT NOT NULL,

    CONSTRAINT fk_pedido_cliente FOREIGN KEY (id_cliente) 
        REFERENCES cliente(id_cliente) ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_pedido_empleado FOREIGN KEY (id_empleado) 
        REFERENCES empleado(id_empleado) ON DELETE RESTRICT ON UPDATE CASCADE
);

-- BONIFICACION depende de cliente_tajinaste_plus
CREATE TABLE bonificacion (
    id_bonificacion SERIAL PRIMARY KEY,
    id_cliente INT NOT NULL,
    fecha_concesion DATE NOT NULL DEFAULT CURRENT_DATE,
    monto NUMERIC(10,2) NOT NULL CHECK (monto > 0),
    descripcion VARCHAR(200),

    CONSTRAINT fk_bonificacion_cliente FOREIGN KEY (id_cliente)
        REFERENCES cliente_tajinaste_plus(id_cliente) ON DELETE CASCADE ON UPDATE CASCADE
);


-- RELACIONES

-- ALMACENA
CREATE TABLE almacena (
    id_zona INT NOT NULL,
    id_producto INT NOT NULL,
    cantidad INT NOT NULL CHECK (cantidad >= 0),
    PRIMARY KEY (id_zona, id_producto),

    CONSTRAINT fk_almacena_zona FOREIGN KEY (id_zona) 
        REFERENCES zona(id_zona) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_almacena_producto FOREIGN KEY (id_producto) 
        REFERENCES producto(id_producto) ON DELETE RESTRICT ON UPDATE CASCADE
);

-- CONTIENE
CREATE TABLE contiene (
    id_pedido INT NOT NULL,
    id_producto INT NOT NULL,
    cantidad INT NOT NULL CHECK (cantidad > 0),
    precio_unitario NUMERIC(10,2) NOT NULL CHECK (precio_unitario >= 0),
    PRIMARY KEY (id_pedido, id_producto),

    CONSTRAINT fk_contiene_pedido FOREIGN KEY (id_pedido) 
        REFERENCES pedido(id_pedido) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_contiene_producto FOREIGN KEY (id_producto) 
        REFERENCES producto(id_producto) ON DELETE RESTRICT ON UPDATE CASCADE
);

-- ASIGNADO
CREATE TABLE asignado (
    id_empleado INT NOT NULL,
    id_zona INT NOT NULL,
    id_puesto INT NOT NULL,
    fecha_inicio DATE NOT NULL,
    fecha_fin DATE,
    PRIMARY KEY (id_empleado, id_zona, id_puesto, fecha_inicio),

    CONSTRAINT chk_fechas_asignacion CHECK (fecha_fin IS NULL OR fecha_fin >= fecha_inicio),
    CONSTRAINT fk_asig_empleado FOREIGN KEY (id_empleado) 
        REFERENCES empleado(id_empleado) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_asig_zona FOREIGN KEY (id_zona) 
        REFERENCES zona(id_zona) ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_asig_puesto FOREIGN KEY (id_puesto) 
        REFERENCES puesto(id_puesto) ON DELETE RESTRICT ON UPDATE CASCADE
);



-- Cálculo de atributos derivados
-- 1. Función que calcula el total sumando las líneas del pedido en la tabla 'contiene'
CREATE OR REPLACE FUNCTION recalcular_coste_total_pedido()
RETURNS TRIGGER AS $$
BEGIN
    UPDATE pedido
    SET coste_total = COALESCE((
        SELECT SUM(cantidad * precio_unitario)
        FROM contiene
        WHERE id_pedido = COALESCE(NEW.id_pedido, OLD.id_pedido)
    ), 0.00)
    WHERE id_pedido = COALESCE(NEW.id_pedido, OLD.id_pedido);
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- 2. Trigger que se activa automáticamente al cambiar datos en 'contiene'
CREATE TRIGGER trg_actualizar_coste_total
AFTER INSERT OR UPDATE OR DELETE ON contiene
FOR EACH ROW
EXECUTE FUNCTION recalcular_coste_total_pedido();

