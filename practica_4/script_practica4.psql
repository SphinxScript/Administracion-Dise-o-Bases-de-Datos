-- EJEMPLOS DE OPERACIONES DELETE

-- ON DELETE CASCADE
-- Al borrar el Vivero #5, se deben borrar automaticamente sus Zonas asociadas
-- y las filas de stock en 'almacena' correspondientes a esas zonas.
DELETE FROM vivero WHERE id_vivero = 5;


-- DEMOSTRACION DE ON DELETE RESTRICT
-- Intentar borrar el Producto #1 dara un ERROR bloqueante porque esta presente en la tabla CONTIENE
-- Para probar se descomenta y dará error
-- DELETE FROM producto WHERE id_producto = 1;


-- BORRADO DE LINEA DE PEDIDO Y RECALCULO AUTOMATICO POR EL TRIGGER
DELETE FROM contiene WHERE id_pedido = 1 AND id_producto = 2;

-- Verificacion tras el borrado (el coste_total del pedido 1 pasa de 33.95 € a 25.00 €)
SELECT id_pedido, coste_total FROM pedido WHERE id_pedido = 1;


-- SELECT * DE CADA TABLA

